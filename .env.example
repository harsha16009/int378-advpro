# ==========================================
# FruitHub Microservices Environment Config
# ==========================================

# 1. API Gateway (Port: 3000)
PORT=3000
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
AUTH_SERVICE_URL=http://auth-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003
PAYMENT_SERVICE_URL=http://payment-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005
TRACKING_SERVICE_URL=http://tracking-service:3006
CHAT_SERVICE_URL=http://chat-service:3007

# 2. Database Connection (MongoDB)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_AUTH_URI=mongodb://admin:admin123@mongo:27017/auth-db?authSource=admin
MONGO_PRODUCT_URI=mongodb://admin:admin123@mongo:27017/product-db?authSource=admin
MONGO_ORDER_URI=mongodb://admin:admin123@mongo:27017/order-db?authSource=admin
MONGO_PAYMENT_URI=mongodb://admin:admin123@mongo:27017/payment-db?authSource=admin
MONGO_TRACKING_URI=mongodb://admin:admin123@mongo:27017/tracking-db?authSource=admin
MONGO_CHAT_URI=mongodb://admin:admin123@mongo:27017/chat-db?authSource=admin

# 3. Auth Service (Port: 3001)
AUTH_PORT=3001
# Optional Google OAuth Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# 4. Product Service (Port: 3002)
PRODUCT_PORT=3002

# 5. Order Service (Port: 3003)
ORDER_PORT=3003

# 6. Payment Service (Port: 3004)
PAYMENT_PORT=3004
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Cashfree Payment Gateway Credentials
CF_APP_ID=your_cashfree_app_id
CF_SECRET_KEY=your_cashfree_secret_key
CF_ENV=sandbox

# 7. Notification Service (Port: 3005)
NOTIFICATION_PORT=3005
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# 8. Tracking Service (Port: 3006)
TRACKING_PORT=3006

# 9. Chat Service (Port: 3007)
CHAT_PORT=3007

# 10. Frontend Client (Port: 5173)
VITE_API_URL=http://localhost:3000/api
# Optional Google Maps JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
